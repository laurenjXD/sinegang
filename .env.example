# Local-only reference. Copy to .dev.vars for Wrangler local development.
# Never commit real values. Put TMDB_API_TOKEN in Worker secrets in production.
TMDB_API_TOKEN=replace-with-tmdb-read-access-token
TMDB_DEFAULT_REGION=US
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PLAYBACK_PROVIDER=bingeapi
BINGEAPI_WELCOME=1
